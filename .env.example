# Server Configuration
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173

# Authentication & Security Secrets (Change in production!)
AUTH_TOKEN_SECRET=replace-with-strong-64-char-random-secret

# Database (SQLite used locally by default; PostgreSQL URL for Prisma production)
SQLITE_DB_PATH=./server/data/kulhad-kaapi.sqlite
DATABASE_URL=postgresql://postgres:password@localhost:5432/kulhad_kaapi?schema=public

# Default Seeded Owner Credentials
DEFAULT_ADMIN_EMAIL=admin@kulhadkaapi.in
DEFAULT_ADMIN_PASSWORD=chai2026

# Razorpay Payment Gateway (Leave blank for explicit Sandbox/Test Simulation Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Image Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Notification Providers (Email / SMS / WhatsApp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_PHONE=+918041238900
